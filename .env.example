DB_PASSWORD=your_secure_password_here

# ml-api (선택)
MODEL_VERSION=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ENABLE_REGIONAL_FORECAST=false

# 뉴스 수집기 (NAVER API HUB Application 의 Client ID · Secret, 검색(뉴스) API) — 서버 컴퓨터의 .env 에만
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 날씨 수집기 (collector/weather) — 서버 컴퓨터의 .env 에만
# 기상청 API허브(apihub.kma.go.kr) 키: ASOS·AWS / 공공데이터포털(data.go.kr) 일반 인증키(Decoding): 농업기상·단기·중기예보
KMA_APIHUB_KEY=
DATA_GO_KR_KEY=

# 회원·게시판은 언제나 backend 의 실제 DB (11-14). 예전 AUTH_MODE · COMPOSE_PROFILES 줄은 이제 필요 없음, 남아 있어도 무시됨
# 관리자 계정은 DB 의 admin 표에 직접 넣음 (deploy/README.md 1-2)

# 서버 화면 포트 (기본 80 → http://서버주소). 80 을 다른 프로그램이 쓰면 8080 등으로
WEB_PORT=80

# 관리자 [지금 갱신] — 갱신 서비스 price-updater (11-17, collector/updater/README.md). 윈도우는 scripts\갱신서비스_처음설정.bat 이 넣어 줌
# UPDATER_TOKEN: 아무도 모르는 긴 글자 (python -c "import secrets;print(secrets.token_hex(24))"). 비우면 갱신 버튼이 안 됨
# NC_DATA_ROOT: 자료 폴더 (안에 05_DB적재\data). UPDATER_DAILY_AT: 매일 자동 실행 시각 (비우면 버튼으로만)
UPDATER_TOKEN=
NC_DATA_ROOT=D:\nong-clock-data
UPDATER_DAILY_AT=
# 가격 수집 인증키 (collector/daily/키_발급_따라하기.md) — collector/daily/.env 와 같은 값
MAFRA_API_KEY=
KAMIS_KEY=
KAMIS_ID=
