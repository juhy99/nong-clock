DB_PASSWORD=your_secure_password_here

# ml-api (선택)
MODEL_VERSION=dummy-0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ENABLE_REGIONAL_FORECAST=false

# 뉴스 수집기 (NAVER API HUB Application 의 Client ID · Secret, 검색(뉴스) API) — 서버 컴퓨터의 .env 에만
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 서버 화면 포트 (기본 80 → http://서버주소). 80 을 다른 프로그램이 쓰면 8080 등으로
WEB_PORT=80
