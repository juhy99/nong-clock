# 복사해서 .env 로 쓰세요 (frontend 폴더 안)
# ML API(FastAPI) 주소. Spring 중계가 생기면 Spring 주소로 바꾸면 됩니다.
VITE_ML_API_BASE=http://localhost:8000
# 관리자 사이트를 사용자 사이트와 다른 주소에 올릴 때만: 관리자 화면의 "사이트에서 보기" 링크가 갈 사용자 사이트 주소
# VITE_SITE_URL=https://farmbid.kr

# ── 테스트 모드: 날씨(기상청)·뉴스(네이버)를 실제 API 로 받아 보기 (npm run dev 에서만 동작) ──
# live 로 바꾸고 아래 키를 채운 뒤 npm run dev 를 다시 실행. 비워 두거나 mock 이면 가짜 데이터.
# 키는 VITE_ 를 붙이지 않는다 (붙이면 화면 코드에 들어가 브라우저에 노출됨). .env 는 커밋 금지.
# VITE_DATA_SOURCE=live
# DATA_GO_KR_KEY=공공데이터포털_일반인증키(Decoding)
# NAVER_CLIENT_ID=NAVER_API_HUB_Client_ID
# NAVER_CLIENT_SECRET=NAVER_API_HUB_Client_Secret

# ── 서버 컴퓨터에 모인 뉴스 보기 (서버 뉴스 수집기가 쌓은 기사). 비워 두면 위 설정대로 ──
# VITE_NEWS_URL=http://서버주소/data/news-recent.json
# 서버의 AI 예측을 쓰려면 위 VITE_ML_API_BASE=http://서버주소:8000 (또는 http://서버주소/ml)

# ── 회원 기능: mock(가짜 계정, 기본) · spring(회원 백엔드 backend-spring 에 연결) ──
# spring 이면 npm run dev 가 /api 를 SPRING_URL 로 넘긴다 (각자 PC 에서 Spring 을 8080 으로 켠 경우 그대로)
# VITE_AUTH=spring
# SPRING_URL=http://localhost:8080
